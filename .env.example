# ── Vercel (Next.js) ortam değişkenleri ──────────────────────────────────────

# Site URL
NEXT_PUBLIC_BASE_URL="https://bilisimsuaritma.com"

# WhatsApp numarası (başında ülke kodu, boşluksuz)
NEXT_PUBLIC_WHATSAPP_NUMBER="905000000000"

# JWT imzalama anahtarı — rastgele uzun bir string
JWT_SECRET="degistirin-guclu-bir-gizli-anahtar"

# PHP Backend — backend/ klasörünün sunucudaki tam URL'i
PHP_API_URL="https://sunucuadresin.com/api"

# Paylaşılan gizli anahtar (PHP config.php ADMIN_SECRET ile AYNI olmalı)
ADMIN_SECRET="cok-guclu-rastgele-bir-anahtar"

# ── PHP Sunucu ortam değişkenleri (Vercel'de gerekmez) ───────────────────────
# MYSQL_HOST=localhost
# MYSQL_DB=bilisimsuaritma
# MYSQL_USER=root
# MYSQL_PASS=sifre
# UPLOAD_BASE_URL=https://sunucuadresin.com/api/uploads
# ALLOWED_ORIGIN=https://bilisimsuaritma.vercel.app
